#!/bin/bash
# Show or hide this pane's panel.
set -u
PANEL_ROOT=$(cd "$(dirname "$0")/.." && pwd)
. "$PANEL_ROOT/shell/key.sh"
PANEL_WAIT_TRIES=15

key=$(panel_key "{}")
[ -n "$key" ] || { panel_py say no_pane >&2; exit 1; }
adapter=$(panel_terminal)
if [ -n "$adapter" ]; then
  handles=$(panel_adapter "$adapter" find "$key" 2>/dev/null)
  if [ -n "$handles" ] && ( . "$adapter"; type term_close >/dev/null 2>&1 ); then
    while IFS= read -r handle; do panel_adapter "$adapter" close "$handle"; done <<< "$handles"
    panel_py say panel_hidden
    exit 0
  fi
fi
"$PANEL_ROOT/hooks/open-panel.sh" --force </dev/null
status=0
if [ -z "$adapter" ] || ! ( . "$adapter"; type term_find >/dev/null 2>&1 ); then
  panel_py say panel_requested
else
  shown=1
  for _ in $(seq "$PANEL_WAIT_TRIES"); do
    [ -n "$(panel_adapter "$adapter" find "$key" 2>/dev/null)" ] && { shown=0; break; }
    sleep 0.2
  done
  if [ "$shown" = 0 ]; then panel_py say panel_shown; else panel_py say panel_failed >&2; status=1; fi
fi
if [ -n "$(panel_token)" ]; then
  panel_py say panel_link
  panel_link "$key"
  echo
fi
exit "$status"
